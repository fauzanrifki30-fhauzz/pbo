<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Aplikasi PBO - CRUD LocalStorage</title>
    <style>
        * { box-sizing: border-box; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; margin: 0; padding: 0; }
        body { background-color: #f4f7f6; padding: 20px; color: #333; }
        .container { max-width: 800px; margin: 0 auto; background: white; padding: 25px; border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); }
        nav { display: flex; gap: 10px; margin-bottom: 20px; border-bottom: 2px solid #eee; padding-bottom: 10px; }
        nav button { padding: 8px 16px; border: none; background: #e0e0e0; cursor: pointer; border-radius: 4px; font-weight: bold; }
        nav button.active { background: #007bff; color: white; }
        .page { display: none; }
        .page.active { display: block; }
        .form-group { margin-bottom: 15px; }
        .form-group label { display: block; margin-bottom: 5px; font-weight: 600; }
        .form-group input, .form-group select { width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px; }
        button.btn-submit { background: #28a745; color: white; border: none; padding: 10px 15px; border-radius: 4px; cursor: pointer; width: 100%; font-weight: bold; }
        button.btn-submit:hover { background: #218838; }
        table { width: 100%; border-collapse: collapse; margin-top: 15px; }
        table, th, td { border: 1px solid #ddd; }
        th, td { padding: 10px; text-align: left; }
        th { background-color: #f8f9fa; }
        .btn-danger { background: #dc3545; color: white; border: none; padding: 5px 10px; border-radius: 3px; cursor: pointer; }
        .btn-edit { background: #ffc107; color: black; border: none; padding: 5px 10px; border-radius: 3px; cursor: pointer; margin-right: 5px; }
        .card { background: #f8f9fa; border: 1px solid #e9ecef; padding: 15px; border-radius: 6px; margin-top: 15px; }
    </style>
</head>
<body>

<div class="container">
    <!-- Navigasi Halaman -->
    <nav id="navbar" style="display: none;">
        <button id="nav-dashboard" onclick="app.showPage('dashboard')">Label Dasar User (CRUD)</button>
        <button id="nav-profile" onclick="app.showPage('profile')">Profile</button>
        <button onclick="app.logout()" style="margin-left: auto; background: #dc3545; color: white;">Logout</button>
    </nav>

    <!-- Halaman 1: Login -->
    <div id="page-login" class="page active">
        <h2>Halaman Login</h2>
        <form onsubmit="app.handleLogin(event)" style="margin-top: 15px;">
            <div class="form-group">
                <label>Username</label>
                <input type="text" id="login-username" required placeholder="Masukkan username">
            </div>
            <div class="form-group">
                <label>Role / Tipe User</label>
                <select id="login-role">
                    <option value="User">User Standard</option>
                    <option value="Admin">Admin System</option>
                </select>
            </div>
            <button type="submit" class="btn-submit">Login</button>
        </form>
    </div>

    <!-- Halaman 2: Label Dasar User (Dashboard CRUD) -->
    <div id="page-dashboard" class="page">
        <h2>Manajemen Data User (CRUD)</h2>
        <form id="user-form" onsubmit="app.handleSaveUser(event)" style="margin-top: 15px;">
            <input type="hidden" id="user-id">
            <div class="form-group">
                <label>Nama</label>
                <input type="text" id="user-name" required>
            </div>
            <div class="form-group">
                <label>Email</label>
                <input type="email" id="user-email" required>
            </div>
            <div class="form-group">
                <label>Tipe Anggota (Polimorfisme)</label>
                <select id="user-role" onchange="app.toggleRoleInput()">
                    <option value="User">User Standard</option>
                    <option value="Admin">Admin System</option>
                </select>
            </div>
            <div class="form-group" id="group-access">
                <label>Tingkat Akses (Atribut Admin)</label>
                <input type="text" id="user-access" placeholder="Contoh: Full Control">
            </div>
            <button type="submit" class="btn-submit" id="btn-save">Tambah Data</button>
        </form>

        <h3 style="margin-top: 25px;">Daftar Pengguna</h3>
        <table>
            <thead>
                <tr>
                    <th>Nama</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Label Dasar (Polimorfisme)</th>
                    <th>Aksi</th>
                </tr>
            </thead>
            <tbody id="user-table-body"></tbody>
        </table>
    </div>

    <!-- Halaman 3: Profile -->
    <div id="page-profile" class="page">
        <h2>Profile Pengguna Aktif</h2>
        <div id="profile-content" class="card"></div>
    </div>
</div>

<script>
    // ==========================================
    // 1. KONSEP PBO: PEWARISAN & POLIMORFISME
    // ==========================================

    // Superclass (Parent Class)
    class User {
        constructor(id, name, email, role = "User") {
            this.id = id;
            this.name = name;
            this.email = email;
            this.role = role;
        }

        // Method yang akan di-override (Polimorfisme)
        getLabel() {
            return `[USER] ${this.name} (${this.email})`;
        }

        getProfileCard() {
            return `
                <p><strong>ID:</strong> ${this.id}</p>
                <p><strong>Nama:</strong> ${this.name}</p>
                <p><strong>Email:</strong> ${this.email}</p>
                <p><strong>Role:</strong> ${this.role}</p>
                <p><strong>Status Label:</strong> Standard User Access</p>
            `;
        }
    }

    // Subclass (Child Class) - Pewarisan (Inheritance)
    class AdminUser extends User {
        constructor(id, name, email, accessLevel) {
            super(id, name, email, "Admin"); // Memanggil constructor milik Superclass
            this.accessLevel = accessLevel || "Super Admin";
        }

        // Override Method getLabel() - Polimorfisme
        getLabel() {
            return `[ADMIN - ${this.accessLevel}] ${this.name} ★`;
        }

        // Override Method getProfileCard() - Polimorfisme
        getProfileCard() {
            return `
                <p><strong>ID:</strong> ${this.id}</p>
                <p><strong>Nama:</strong> ${this.name}</p>
                <p><strong>Email:</strong> ${this.email}</p>
                <p><strong>Role:</strong> ${this.role}</p>
                <p><strong>Tingkat Akses:</strong> ${this.accessLevel}</p>
                <p><strong>Status Label:</strong> High Level Privilege</p>
            `;
        }
    }

    // Factory Class untuk Instansiasi Objek berdasarkan tipe
    class UserFactory {
        static createCustomUser(data) {
            if (data.role === "Admin") {
                return new AdminUser(data.id, data.name, data.email, data.accessLevel);
            }
            return new User(data.id, data.name, data.email, data.role);
        }
    }

    // ==========================================
    // 2. LOGIKA APLIKASI & LOCALSTORAGE
    // ==========================================

    class App {
        constructor() {
            this.users = this.loadData();
            this.currentUser = JSON.parse(localStorage.getItem('currentUser')) || null;
            this.init();
        }

        loadData() {
            const rawData = JSON.parse(localStorage.getItem('usersData')) || [
                { id: "1", name: "Budi Santoso", email: "budi@mail.com", role: "User" },
                { id: "2", name: "Siti Rahma", email: "siti@admin.com", role: "Admin", accessLevel: "Full Access" }
            ];
            // Mengubah plain object dari localStorage menjadi Instance Class
            return rawData.map(item => UserFactory.createCustomUser(item));
        }

        saveData() {
            localStorage.setItem('usersData', JSON.stringify(this.users));
        }

        init() {
            if (this.currentUser) {
                document.getElementById('navbar').style.display = 'flex';
                this.showPage('dashboard');
            } else {
                this.showPage('login');
            }
            this.toggleRoleInput();
        }

        showPage(pageId) {
            document.querySelectorAll('.page').forEach(page => page.classList.remove('active'));
            document.querySelectorAll('nav button').forEach(btn => btn.classList.remove('active'));
            
            document.getElementById(`page-${pageId}`).classList.add('active');
            const navBtn = document.getElementById(`nav-${pageId}`);
            if (navBtn) navBtn.classList.add('active');

            if (pageId === 'dashboard') this.renderTable();
            if (pageId === 'profile') this.renderProfile();
        }

        handleLogin(e) {
            e.preventDefault();
            const name = document.getElementById('login-username').value;
            const role = document.getElementById('login-role').value;
            
            const userData = {
                id: Date.now().toString(),
                name: name,
                email: `${name.toLowerCase().replace(/\s+/g, '')}@mail.com`,
                role: role,
                accessLevel: role === 'Admin' ? 'System Administrator' : undefined
            };

            this.currentUser = UserFactory.createCustomUser(userData);
            localStorage.setItem('currentUser', JSON.stringify(this.currentUser));
            
            document.getElementById('navbar').style.display = 'flex';
            this.showPage('dashboard');
        }

        logout() {
            localStorage.removeItem('currentUser');
            this.currentUser = null;
            document.getElementById('navbar').style.display = 'none';
            this.showPage('login');
        }

        toggleRoleInput() {
            const role = document.getElementById('user-role').value;
            const accessGroup = document.getElementById('group-access');
            accessGroup.style.display = role === 'Admin' ? 'block' : 'none';
        }

        // --- OPERATIONS CRUD ---

        handleSaveUser(e) {
            e.preventDefault();
            const id = document.getElementById('user-id').value;
            const name = document.getElementById('user-name').value;
            const email = document.getElementById('user-email').value;
            const role = document.getElementById('user-role').value;
            const accessLevel = document.getElementById('user-access').value;

            const userData = {
                id: id || Date.now().toString(),
                name,
                email,
                role,
                accessLevel: role === 'Admin' ? accessLevel : undefined
            };

            const newUserObj = UserFactory.createCustomUser(userData);

            if (id) {
                // Update
                const index = this.users.findIndex(u => u.id === id);
                if (index !== -1) this.users[index] = newUserObj;
            } else {
                // Create
                this.users.push(newUserObj);
            }

            this.saveData();
            this.resetForm();
            this.renderTable();
        }

        editUser(id) {
            const user = this.users.find(u => u.id === id);
            if (!user) return;

            document.getElementById('user-id').value = user.id;
            document.getElementById('user-name').value = user.name;
            document.getElementById('user-email').value = user.email;
            document.getElementById('user-role').value = user.role;
            
            this.toggleRoleInput();
            if (user.role === 'Admin') {
                document.getElementById('user-access').value = user.accessLevel || '';
            }

            document.getElementById('btn-save').innerText = 'Update Data';
        }

        deleteUser(id) {
            if (confirm('Yakin ingin menghapus data ini?')) {
                this.users = this.users.filter(u => u.id !== id);
                this.saveData();
                this.renderTable();
            }
        }

        resetForm() {
            document.getElementById('user-form').reset();
            document.getElementById('user-id').value = '';
            document.getElementById('btn-save').innerText = 'Tambah Data';
            this.toggleRoleInput();
        }

        renderTable() {
            const tbody = document.getElementById('user-table-body');
            tbody.innerHTML = '';

            this.users.forEach(user => {
                const tr = document.createElement('tr');
                tr.innerHTML = `
                    <td>${user.name}</td>
                    <td>${user.email}</td>
                    <td>${user.role}</td>
                    <!-- Implementasi Polimorfisme: getLabel() menghasilkan teks berbeda tergantung tipe objek -->
                    <td><strong>${user.getLabel()}</strong></td>
                    <td>
                        <button class="btn-edit" onclick="app.editUser('${user.id}')">Edit</button>
                        <button class="btn-danger" onclick="app.deleteUser('${user.id}')">Hapus</button>
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        renderProfile() {
            const container = document.getElementById('profile-content');
            if (this.currentUser) {
                // Re-instantiate class agar method tetap aktif setelah dibaca dari JSON
                const activeUserObj = UserFactory.createCustomUser(this.currentUser);
                // Implementasi Polimorfisme: getProfileCard()
                container.innerHTML = activeUserObj.getProfileCard();
            }
        }
    }

    // Inisialisasi Aplikasi
    const app = new App();
</script>

</body>
</html>
